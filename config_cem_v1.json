{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 2,
    "stake_currency": "USDT",
    "stake_amount": 200,
    "dry_run": true,
    "dry_run_wallet": 1000,
    "timeframe": "5m",
    "strategy": "CemV1Strategy",
    "minimal_roi": {
        "0": 0.01
    },
    "stoploss": -0.10,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10
    },
    "entry_pricing": {
        "price_side": "ask",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "bid",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "binance",
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT"
        ]
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "telegram": {
        "enabled": true,
        "token": "8202801760:AAEzGPaPzw-Z2IlHWdh4ONpD3KDiimiX9EQ",
        "chat_id": "5709016282"
    },
    "freqai": {
        "enabled": true,
        "freqaimodel": "LightGBMRegressor",
        "identifier": "cem_v1_advanced",
        "train_period_days": 30,
        "backtest_period_days": 7,
        "feature_parameters": {
            "include_timeframes": [
                "5m",
                "15m",
                "1h"
            ],
            "indicator_periods_candles": [
                14,
                28
            ],
            "label_period_candles": 24,
            "include_corr_pairlist": [
                "BTC/USDT",
                "ETH/USDT"
            ]
        },
        "data_split_parameters": {
            "test_size": 0.2,
            "random_state": 1
        },
        "model_training_parameters": {}
    }
}