{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "trading_mode": "spot",
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": 200,
    "fiat_display_currency": "USD",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "timerange": "20250901-20251001",
    "timeframe": "5m",
    "strategy": "GeminiV3_strategy",
    "exchange": {
        "name": "binance",
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT"
        ]
    },
    "entry_pricing": {
        "price_side": "ask",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "bid",
        "use_order_book": true,
        "order_book_top": 1
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "freqai": {
        "enabled": true,
        "freqaimodel": "LightGBMClassifier",
        "identifier": "gemini-v9-classifier-features",
        "train_period_days": 30,
        "backtest_period_days": 7,
        "feature_parameters": {
            "include_timeframes": [
                "5m",
                "15m",
                "1h"
            ],
            "indicator_periods_candles": [
                14,
                28
            ],
            "label_period_candles": 24,
            "include_corr_pairlist": [
                "BTC/USDT",
                "ETH/USDT"
            ]
        },
        "data_split_parameters": {
            "test_size": 0.2,
            "random_state": 1
        },
        "model_training_parameters": {}
    }
}
