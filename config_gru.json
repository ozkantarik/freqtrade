{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 0,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "timeframe": "5m",
    "strategy": "GRUPredictorStrategy",
    "minimal_roi": {
        "0": 1.0
    },
    "stoploss": -0.99,
    "entry_pricing": {
        "price_side": "ask",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "bid",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "binance",
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT"
        ]
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "freqai": {
        "enabled": true,
        "identifier": "gru_predictor_v1",
        "train_period_days": 30,
        "freqaimodel": "PyTorchGRU",
        "feature_parameters": {
            "include_timeframes": ["5m"],
            "include_corr_pairlist": [],
            "label_period_candles": 10,
            "indicator_periods_candles": [14]
        },
        "data_split_parameters": {
            "test_size": 0.2
        },
        "model_training_parameters" : {
            "hidden_size": 64,
            "num_layers": 2,
            "epochs": 50,
            "batch_size": 32
        }
    }
}