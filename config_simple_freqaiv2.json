{
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": 100,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "timeframe": "5m",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "cancel_open_orders_on_exit": false,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 30
    },
    "bid_strategy": {
        "price_side": "ask",
        "ask_last_balance": 0.0,
        "use_order_book": false,
        "order_book_top": 1,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "ask_strategy": {
        "price_side": "bid",
        "use_order_book": false,
        "order_book_top": 1
    },
    "strategy": "SimpleFreqaiV2",
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {
            "options": {
                "defaultType": "spot"
            }
        },
        "ccxt_async_config": {
            "enableRateLimit": true
        },
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT"
        ]
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "edge": {
        "enabled": false
    },
    "backtesting": {
        "timerange": "20250901-20251001",
        "export_filename": "user_data/backtest_results/latest_run.feather"
    },
    "freqai": {
        "enabled": true,
        "freqaimodel": "LightGBMRegressor",
        "train_test_split_ratio": 0.8,
        "feature_parameters": {
            "include_timeframes": [
                "5m"
            ],
            "label_period_candles": 10,
            "indicator_periods_candles": [
                14,
                20,
                50
            ],
            "include_corr_pairlist": [
                "BTC/USDT",
                "ETH/USDT"
            ]
        },
        "data_split_parameters": {
            "test_size": 0.2
        }
    }
}
